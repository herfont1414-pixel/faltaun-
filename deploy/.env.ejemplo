# Copiar este archivo como ".env" (en esta misma carpeta) y completar los valores.

# Dirección pública del sistema, SIN https:// (ej: madero.midominio.com.ar).
# El nombre tiene que apuntar (registro DNS "A") a la IP pública de este servidor.
# Para probar solo por IP, dejar ":80" y poner COOKIE_SECURE=false.
DOMINIO=:80

# La misma dirección pero con https:// (se usa en los mensajes de WhatsApp a los clientes).
# Si todavía no hay dominio, dejar vacío.
MENU_URL=

# Clave de la base de datos: larga y al azar, solo letras y números (ej: openssl rand -hex 24)
DB_CLAVE=
DB_USUARIO=maderosys
DB_NOMBRE=maderosys

# PIN (4 números) del primer usuario administrador. Solo se usa la primera vez, con la base vacía;
# si se traen los datos de la base anterior (traer-datos.sh), los usuarios vienen con ella.
ADMIN_PIN=

# MODO NUBE (opcional). Si este servidor va a ser SOLO el menú online (el sistema de verdad corre en la PC
# del local), poner MADERO_ROL=nube y una clave de conexión larga (openssl rand -hex 24) que se carga
# igual en la PC. Con MADERO_ROL vacío es el sistema completo.
MADERO_ROL=
SYNC_TOKEN=

# "true" cuando se entra por https:// (lo normal). "false" solo para pruebas por http://IP
COOKIE_SECURE=true

# Texto que se ve en el panel como versión (opcional).
APP_VERSION=servidor

# Opcional: mandar también cada copia de seguridad a otro equipo (rsync por SSH, con clave sin contraseña).
# COPIA_REMOTA="usuario@otro-equipo:/ruta/backups/"
